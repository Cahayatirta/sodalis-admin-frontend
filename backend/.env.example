# ==============================================================================
# Sodalis Micro-Finance — Admin Underwriting Terminal Environment Config
# ==============================================================================

# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Single Admin Credentials (Env-Based, No Admin Table)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sodalis.id
ADMIN_PASSWORD=SodalisSecure2026!
# 16-character base32 secret for TOTP (Google Authenticator)
# Run `npm run generate-totp` to generate a fresh secret and QR setup
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# JWT Configuration
JWT_SECRET=sodalis-super-secure-production-jwt-token-secret-2026
JWT_EXPIRES_IN=24h

# Supabase PostgreSQL Service Connection (Bypasses RLS)
# DO NOT alter or migrate tables. Connects to 7 existing tables.
SUPABASE_URL= https://ceflaoetcsnmhplmsfva.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# Midtrans Payment Gateway (Snap & Disbursements)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false


                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/loans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["loans"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('KPI counters are present', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.kpi).to.have.property('pendingUnderwriting');",
                  "    pm.expect(json.data.kpi).to.have.property('approvedForDisbursal');",
                  "    pm.expect(json.data.kpi).to.have.property('flaggedHighRisk');",
                  "    if (json.data.items && json.data.items.length > 0) {",
                  "        var firstLoan = json.data.items[0];",
                  "        pm.environment.set('sampleLoanId', firstLoan.id);",
                  "        pm.environment.set('midtransOrderId', firstLoan.loan_code);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }

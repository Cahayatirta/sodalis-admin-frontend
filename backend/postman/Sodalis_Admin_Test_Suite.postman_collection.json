          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login success status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Response contains token & admin data', function () {",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.data).to.have.property('token');",
                  "  pm.expect(json.data).to.have.property('admin');",
                  "  const expectedEmail = pm.environment.get('adminIdentifier') || pm.variables.get('adminIdentifier');",
                  "  if (expectedEmail && expectedEmail.includes('@')) {",
                  "    pm.expect(json.data.admin.email).to.eql(expectedEmail);",
                  "  }",
                  "});",
                  "if (json.data && json.data.token) {",
                  "  pm.environment.set('jwtToken', json.data.token);",
                  "  pm.collectionVariables.set('jwtToken', json.data.token);",
                  "}",
                  "if (json.data && json.data.admin && json.data.admin.id) {",
                  "  pm.environment.set('adminId', json.data.admin.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }

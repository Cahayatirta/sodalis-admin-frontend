        {
          "name": "1.1 Get TOTP QR Setup",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/totp-setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "totp-setup"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response time < 5000ms', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});",
                  "pm.test('Response has TOTP secret and QR Code', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('success', true);",
                  "  const data = json.data || {};",
                  "  const hasSecret = data.totpSecret || data.totp_secret || data.secret;",
                  "  const hasQr = data.qrCodeUrl || data.qrCodeDataUrl || data.qr_code;",
                  "  pm.expect(hasSecret).to.be.ok;",
                  "  pm.expect(hasQr).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
